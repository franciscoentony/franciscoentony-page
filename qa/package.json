{
  "name": "franciscoentony-page-qa",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "playwright test",
    "test:prod": "QA_BASE_URL=https://franciscoentony.com playwright test",
    "lighthouse": "node scripts/lighthouse.mjs",
    "baseline": "node scripts/baseline.mjs",
    "report": "playwright show-report reports/html",
    "summary": "node scripts/summarize.mjs",
    "test:redesign": "playwright test --grep @redesign",
    "test:dod": "playwright test --grep @dod",
    "test:perf": "QA_PERF=1 playwright test --project=perf-mobile --project=perf-desktop --workers=1",
    "perf-report": "node scripts/perf-report.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "chrome-launcher": "^1.2.2",
    "lighthouse": "^13.6.0"
  }
}
